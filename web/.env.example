# Absolute path recommended; if unset the app checks ../registry.db then ./registry.db
REGISTRY_DB_PATH=../registry.db

ENABLE_MANUAL_RUNBOOK_TRIGGER=true
RUNBOOK_MANUAL_COMMAND=python run_registry_pipeline.py --workdir .. --db ../registry.db --out-dir ..
RUNBOOK_MANUAL_WORKDIR=..

# HTTP port (Next.js also honors the PORT environment variable at runtime)
# PORT=3000
